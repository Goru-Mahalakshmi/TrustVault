ENVIRONMENT=development
# Runtime role (restricted: INSERT+SELECT only on audit_logs). docker compose up -d starts this database on :5433.
DATABASE_URL=postgresql+asyncpg://trustvault_app:app_dev_pw@localhost:5433/trustvault
# Owner role: used ONLY by scripts/init_db.py (schema, grants, audit trigger). Never give this to the API process.
OWNER_DATABASE_URL=postgresql+asyncpg://trustvault_owner:owner_dev_pw@localhost:5433/trustvault
# python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
MASTER_KEY_B64=
AUDIT_HMAC_KEY=change-me-long-random-string
STORAGE_DIR=./storage
# optional: enables advisory AI grantee suggestions
ANTHROPIC_API_KEY=
# disk (default) or db (encrypted blobs in PostgreSQL, for hosts without a persistent disk such as Render's free tier)
STORAGE_BACKEND=disk

# AI suggestions (optional). Provider style 1: Anthropic
ANTHROPIC_API_KEY=
# Provider style 2: any OpenAI-compatible API (many free tiers). Check the provider's CURRENT free-tier terms and model names.
# AI_PROVIDER=openai_compatible
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=<model name from the provider's docs>
