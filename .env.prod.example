# Copy to .env.prod and fill EVERY value. Never commit .env.prod.
DOMAIN=vault.example.com
# Generate each secret:  python -c "import secrets;print(secrets.token_hex(24))"
POSTGRES_SUPERUSER_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
# python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"   (LOSE THIS KEY = LOSE EVERY FILE)
MASTER_KEY_B64=
# python -c "import secrets;print(secrets.token_urlsafe(48))"   (keep a copy elsewhere: audit verification needs it)
AUDIT_HMAC_KEY=
# The proxy network inside Docker (so the real client IP is read from X-Forwarded-For)
TRUSTED_PROXIES=["172.16.0.0/12","10.0.0.0/8","192.168.0.0/16"]
APP_BASE_URL=https://vault.example.com
EMAIL_BACKEND=console
# smtp: set EMAIL_BACKEND=smtp and SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD / SMTP_FROM
# optional advisory AI suggestions
ANTHROPIC_API_KEY=
